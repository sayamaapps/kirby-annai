<?xml version="1.0"?>
<ruleset name="Annai"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Annai. Every exclusion and raised threshold has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- The helper classes are static by design, as in Kirby's own code. -->
		<exclude name="StaticAccess" />
		<!-- Public flags are part of the public API (VER-3). -->
		<exclude name="BooleanArgumentFlag" />
		<!-- The assignment in a condition keeps the reading order. -->
		<exclude name="IfStatementAssignment" />
		<!-- Early returns are not enforced; some guards read better with else. -->
		<exclude name="ElseExpression" />
	</rule>

	<!-- codesize: the cyclomatic threshold is raised to 21. The highest methods are the
	     schema, rendering and page-selection builders (Pages::entries() 20, render() 19,
	     localBusiness() 18), which branch on purpose: each branch is one documented
	     output or selection rule. Lower it when they split. -->
	<rule ref="rulesets/codesize.xml/CyclomaticComplexity">
		<properties>
			<property name="reportLevel" value="21" />
		</properties>
	</rule>
	<rule ref="rulesets/codesize.xml/ExcessiveMethodLength" />
	<rule ref="rulesets/codesize.xml/ExcessiveParameterList" />

	<rule ref="rulesets/design.xml">
		<!-- Routes, Business and Options are the public classes; splitting them changes the API (VER-3). -->
		<exclude name="TooManyPublicMethods" />
		<exclude name="TooManyMethods" />
		<exclude name="CouplingBetweenObjects" />
	</rule>

	<rule ref="rulesets/naming.xml">
		<!-- Short names are the formulas and array keys of the tables. -->
		<exclude name="ShortVariable" />
		<!-- I18n::t() is the translation shorthand used in snippets and tests. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
